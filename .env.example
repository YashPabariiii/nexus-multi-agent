TAVILY_API_KEY=

# Langfuse tracing (optional — leave empty to disable). Cloud free tier or self-host: https://langfuse.com/self-hosting
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

FREE_TIER_BRIEF_LIMIT=5
FREE_TIER_DEPTH_LIMIT=standard

JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

LOG_LEVEL=INFO
ENVIRONMENT=development
